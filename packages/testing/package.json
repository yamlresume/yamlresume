{
  "name": "@yamlresume/testing",
  "version": "0.16.0",
  "private": true,
  "description": "Shared testing utilities for YAMLResume packages",
  "license": "MIT",
  "author": {
    "name": "YAMLResume",
    "email": "support@yamlresume.com",
    "url": "https://yamlresume.dev"
  },
  "keywords": [
    "YAMLResume",
    "Testing",
    "Test Utils"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "build:clean": "rm -rf dist",
    "build:prod": "tsup --dts --minify --sourcemap",
    "test": "vitest --run",
    "test:cov": "vitest --coverage --run",
    "test:watch": "vitest",
    "typedoc": "typedoc"
  },
  "dependencies": {
    "@yamlresume/core": "workspace:*",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "consola": "^3.4.2",
    "execa": "^10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yamlresume/yamlresume.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/yamlresume/yamlresume/issues"
  },
  "homepage": "https://yamlresume.dev",
  "engines": {
    "node": ">=20.0.0"
  }
}
