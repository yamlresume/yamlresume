{
  "name": "@yamlresume/ai",
  "version": "0.16.0",
  "description": "AI-powered generation and translation for YAMLResume",
  "license": "MIT",
  "author": {
    "name": "YAMLResume",
    "email": "support@yamlresume.com",
    "url": "https://yamlresume.dev"
  },
  "keywords": [
    "YAMLResume",
    "CV",
    "Resume",
    "AI",
    "LLM",
    "Generation",
    "Translation"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "build:clean": "rm -rf dist",
    "build:prod": "tsup --dts --minify --sourcemap",
    "prepublishOnly": "pnpm test",
    "test": "vitest --run",
    "test:cov": "vitest --coverage --run",
    "test:watch": "vitest",
    "typedoc": "typedoc"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.10",
    "@yamlresume/core": "workspace:*",
    "ai": "^5.0.52",
    "consola": "^3.4.2",
    "tslib": "^2.8.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yamlresume/yamlresume.git",
    "directory": "packages/ai"
  },
  "bugs": {
    "url": "https://github.com/yamlresume/yamlresume/issues"
  },
  "homepage": "https://yamlresume.dev/docs/ecosystem/ai",
  "engines": {
    "node": ">=22.0.0"
  }
}
