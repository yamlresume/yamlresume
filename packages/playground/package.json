{
  "name": "@yamlresume/playground",
  "version": "0.17.0",
  "description": "Shared playground component for YAMLResume",
  "license": "MIT",
  "author": {
    "name": "YAMLResume",
    "email": "support@yamlresume.com",
    "url": "https://yamlresume.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yamlresume/yamlresume.git",
    "directory": "packages/playground"
  },
  "bugs": {
    "url": "https://github.com/yamlresume/yamlresume/issues"
  },
  "homepage": "https://yamlresume.dev/docs/ecosystem/playground",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:prod": "tsup --dts --minify --sourcemap",
    "build:watch": "tsup --watch",
    "build:clean": "rm -rf dist",
    "test": "vitest --run",
    "web:dev": "pnpm -C web dev",
    "web:build": "pnpm -C web build",
    "test:cov": "vitest --coverage --run",
    "test:watch": "vitest",
    "lint": "biome check src",
    "typedoc": "typedoc"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=3"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tabler/icons-react": "^3.48.0",
    "@yamlresume/core": "workspace:*",
    "@yamlresume/samples": "workspace:*",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.1",
    "jszip": "^3.10.2",
    "monaco-editor": "^0.54.0",
    "monaco-yaml": "^5.5.1",
    "next-themes": "^0.4.6",
    "react-resizable-panels": "^4.14.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
