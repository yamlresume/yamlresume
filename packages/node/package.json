{
  "name": "@yamlresume/node",
  "version": "0.15.3",
  "description": "Node.js runtime support for YAMLResume",
  "license": "MIT",
  "author": {
    "name": "YAMLResume",
    "email": "support@yamlresume.com",
    "url": "https://yamlresume.dev"
  },
  "keywords": [
    "YAMLResume",
    "CV",
    "Resume",
    "LaTeX",
    "Typesetting",
    "PDF",
    "YAML",
    "JSON",
    "Node.js"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "build:clean": "rm -rf dist",
    "build:prod": "tsup --dts --minify --sourcemap",
    "prepublishOnly": "pnpm test",
    "test": "vitest --run",
    "test:cov": "vitest --coverage --run",
    "test:watch": "vitest",
    "typedoc": "typedoc"
  },
  "dependencies": {
    "@yamlresume/ai": "workspace:*",
    "@yamlresume/core": "workspace:*",
    "@yamlresume/samples": "workspace:*",
    "chokidar": "^5.0.0",
    "coalescifn": "^1.0.0",
    "execa": "^10.0.0",
    "which": "^7.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/which": "^3.0.4",
    "@yamlresume/testing": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yamlresume/yamlresume.git",
    "directory": "packages/node"
  },
  "bugs": {
    "url": "https://github.com/yamlresume/yamlresume/issues"
  },
  "homepage": "https://yamlresume.dev/docs/node",
  "engines": {
    "node": ">=20.0.0"
  }
}
