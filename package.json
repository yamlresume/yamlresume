{
  "name": "@yamlresume/yamlresume",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "build:watch": "pnpm -r build:watch",
    "build:clean": "pnpm -r build:clean",
    "build:prod": "pnpm -r build:prod",
    "test": "pnpm -r test",
    "test:smoke": "pnpm -r test:smoke",
    "test:e2e": "pnpm build:prod && pnpm cli test:e2e",
    "test:cov": "pnpm -r test:cov",
    "test:watch": "pnpm -r test:watch",
    "check": "pnpm check:biome --write && pnpm check:tsc && pnpm license:add",
    "check:ci": "pnpm check:node && pnpm check:biome && pnpm check:tsc && pnpm license:check",
    "check:node": "node scripts/check-node-version.mjs",
    "check:tsc": "pnpm -r exec tsc --noEmit && pnpm --filter yamlresume exec tsc --noEmit -p e2e/tsconfig.json",
    "check:biome": "pnpm biome check --unsafe packages/*/src packages/*/scripts packages/playground/web/src scripts/check-node-version.mjs",
    "license:add": "node scripts/addlicense.mjs",
    "license:check": "node scripts/addlicense.mjs -c",
    "prepare": "husky",
    "publish:github": "pnpm build:prod && pnpm publish -r --no-git-checks --access public",
    "commitlint": "commitlint --edit",
    "release": "commit-and-tag-version -c .versionrc.cjs",
    "ai": "pnpm --filter @yamlresume/ai",
    "cli": "pnpm --filter yamlresume",
    "core": "pnpm --filter @yamlresume/core",
    "create-yamlresume": "pnpm --filter create-yamlresume",
    "json2yamlresume": "pnpm --filter json2yamlresume",
    "node": "pnpm --filter @yamlresume/node",
    "playground": "pnpm --filter @yamlresume/playground",
    "samples": "pnpm --filter @yamlresume/samples",
    "testing": "pnpm --filter @yamlresume/testing",
    "typedoc": "pnpm -r typedoc"
  },
  "lint-staged": {
    "packages/*/src/**/*.ts": "pnpm check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "addlicense-ts": "^2.0.0",
    "commit-and-tag-version": "^13.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tsup": "8.5.1",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "version": "0.16.2"
}
